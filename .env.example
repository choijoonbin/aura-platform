# ==================== LLM Configuration ====================
# Azure OpenAI (우선 사용)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# 사용 가능: gpt-4.1, gpt-4.1-mini, gpt-4o, gpt-4o-mini, gpt-5, gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI 직접 연결 (Azure 미사용 시)
# OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# MODEL_VERSION_PIN=gpt-4.1-2025-04-14
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
# PROMPT_VERSION_PIN=aura-auditor-v1
# EXPERIMENT_TAG=

# ==================== Database (PostgreSQL + pgvector) ====================
# 백엔드 PostgreSQL과 동일한 DB 또는 접속 가능한 URL (dwp_aura.rag_chunk 사용)
# 주소: localhost:5432, 유저: dwp_user, DB명: dwp_auth | dwp_main | dwp_aura (서비스별)
# DATABASE_URL=postgresql://dwp_user:YOUR_PASSWORD@localhost:5432/dwp_aura

# ==================== RAG / Embedding (Phase 6 Vector Pipeline) ====================
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# RAG 벡터 저장소: pgvector 권장 (백엔드 PostgreSQL과 동일 DB 사용 시)
VECTOR_STORE_TYPE=pgvector
# VECTOR_STORE_TYPE=none
# CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_COLLECTION_NAME=aura_rag
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=aura-rag
# PINECONE_NAMESPACE=default
# Backend RagController: 벡터화 완료 후 processing_status 갱신
# BACKEND_RAG_CALLBACK_URL=http://localhost:8080/api/synapse/rag
# 로컬 경로 수집 시 허용 기준 (document_path는 이 경로 하위만 허용, 미설정 시 검사 생략)
# RAG_ALLOWED_DOCUMENT_BASE_PATH=/shared/aura/documents
# 규정 지식 버전 핀 (metadata.index_version)
# RAG_INDEX_VERSION=2026Q1
# 규정 효력일 강제값(YYYY-MM-DD). 미설정 시 case occurredAt 기준
# RAG_EFFECTIVE_DATE_OVERRIDE=2026-01-01
# 청크 배치 크기 (20~50). 응답 batches 또는 백엔드 저장 API 호출 단위
# RAG_CHUNK_BATCH_SIZE=30
# 청킹 버전: v1(기존 rule-based), v2(에이전트형 4단계 파이프라인). v2는 로컬 테스트 후 전환 권장.
# RAG_CHUNKING_VERSION=v1

# v2 단계별 기능 플래그 (RAG_CHUNKING_VERSION=v2일 때 적용)
# RAG_CHUNKING_V2_PROFILING_ENABLED=true       # Step 1: LLM 문서 프로파일링
# RAG_CHUNKING_V2_LAYOUT_AWARE_ENABLED=true    # Step 2: 표/리스트 블록 보호
# RAG_CHUNKING_V2_SEMANTIC_HYBRID_ENABLED=true # Step 2: 계층형 내 의미론적 경계 탐지
# RAG_CHUNKING_V2_CONTEXT_INJECT_ENABLED=true  # Step 3: doc_summary 본문 주입
# RAG_CHUNKING_V2_LLM_ENRICH_ENABLED=true      # Step 3: 약한 메타데이터 LLM 보강
# RAG_CHUNKING_V2_LLM_VERIFY_ENABLED=true      # Step 4: Self-Correction (병합/분할 실제 적용)
# RAG_CHUNKING_V2_FEEDBACK_ENABLED=true        # Feedback: 저품질 청크 자동 재교정
# 청크 배치 저장 URL (설정 시 Aura가 벡터화 완료 후 배치마다 POST). host가 localhost가 아니면 해당 host에서 8080/8085 접근 가능해야 함.
# Gateway: http://<host>:8080/api/synapse/rag/chunks  /  SynapseX 직통: http://<host>:8085/synapse/rag/chunks
# BACKEND_RAG_CHUNKS_SAVE_URL=http://localhost:8080/api/synapse/rag/chunks

# ==================== Observability (선택) ====================
# Langfuse: LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_HOST
# LangSmith: LANGCHAIN_TRACING_V2=true, LANGCHAIN_API_KEY, LANGCHAIN_PROJECT

# ==================== External Search (Finance Agent / 감사 파이프라인) ====================
# Tavily API: 설정 시 web_search 도구에서 우선 사용. 미설정 시 DuckDuckGo 폴백 (langchain-community)
# TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# ==================== Phase2 BE Callback ====================
# DWP_GATEWAY_URL=http://localhost:8080
# CALLBACK_PATH=/api/synapse/internal/aura/callback

# ==================== Synapse (Gateway 8080 경유) ====================
# Agent Tool API: cases, documents, open-items, lineage
# SYNAPSE_BASE_URL=http://localhost:8080/api/synapse/agent-tools
# Agent Stream push (미지정 시 http://localhost:8080/api/synapse/agent/events)
# AGENT_STREAM_PUSH_URL=http://localhost:8080/api/synapse/agent/events

# ==================== Agentic v2 / Shadow Run ====================
# [권장 시작값]
# - AGENTIC_V2_ENABLED=true
# - AGENTIC_V2_PRIMARY_AGENT_KEY=finance_aura_v2_agentic
# - AGENTIC_V2_LEGACY_AGENT_KEY=finance_aura
# - AGENTIC_V2_EMIT_AGENT_STREAM=false
# - AGENTIC_SHADOW_RUN_ENABLED=true
#
# [주의사항]
# 1) AGENTIC_V2_EMIT_AGENT_STREAM=false (권장)
#    - 분석단계 타임라인은 AGENT_EVENT/step 중심으로 표시됩니다.
#    - 임의 서술형 스트림(AGENT_STREAM) 과다 노출을 막아, 실제 이벤트 기반 추적이 쉬워집니다.
# 2) AGENTIC_V2_EMIT_AGENT_STREAM=true (디버그/시연용)
#    - AGENT_STREAM 문장이 다시 표시됩니다.
#    - 화면 중복/잡음이 늘 수 있으므로 운영 기본값으로는 비권장입니다.
# 3) AGENTIC_SHADOW_RUN_ENABLED=true일 때
#    - primary 실행 + shadow 비교가 동시에 수행됩니다(추가 비용/지연 가능).
#    - 전환 검증 단계에서는 true 권장, 운영 전환 후에는 false로 낮출 수 있습니다.
# 4) AGENTIC_SHADOW_AGENT_KEY 설정
#    - 일반적으로 primary와 다른 경로(legacy 또는 v2)를 넣어 비교합니다.
#    - primary와 동일 key를 넣으면 비교 효용이 낮습니다.
# 5) 설정 변경 후 반드시 Aura 재기동 필요
#    - uvicorn 재시작 전에는 변경값이 반영되지 않습니다.
#
# AGENTIC_V2_ENABLED=true
# AGENTIC_V2_PRIMARY_AGENT_KEY=finance_aura_v2_agentic
# AGENTIC_V2_LEGACY_AGENT_KEY=finance_aura
# AGENTIC_V2_EMIT_AGENT_STREAM=false
# AGENTIC_SHADOW_RUN_ENABLED=true
# AGENTIC_SHADOW_AGENT_KEY=finance_aura
# AGENTIC_SHADOW_SAMPLE_RATIO=1.0
# AGENTIC_SHADOW_CASE_TYPES=HOLIDAY_USAGE

# ==================== 필수 ====================
# JWT 검증: dwp-auth-server와 동일한 값 사용 (SECRET_KEY 또는 JWT_SECRET)
# Auth Server application.yml의 JWT_SECRET과 일치해야 함
JWT_SECRET=your_shared_secret_key_must_be_at_least_256_bits_long_for_HS256
# SECRET_KEY=your-32-byte-minimum-secret-key-for-jwt  # JWT_SECRET 우선 사용 시 생략 가능
REDIS_URL=redis://localhost:6379/0
